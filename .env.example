# ── Core App ──────────────────────────────────────────────
APP_ENV=demo
APP_URL=http://127.0.0.1:8000
SESSION_SECRET=change-me-in-production
DEMO_MODE=true

# ── Database ───────────────────────────────────────────────
HOSPITAL_DB_PATH=hospital_ecosystem.db
AUDIT_DB_PATH=enclave_audit_trail.db
# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/elvon_db

# ── Auth / OTP ─────────────────────────────────────────────
# In demo mode OTP is returned in the API response (no real email/SMS needed)
OTP_PROVIDER=console
JWT_SECRET=change-me-in-production

# ── Mock PACS / DICOM ──────────────────────────────────────
MOCK_PACS_DATA_PATH=./app/storage/mock-data/dicom
MOCK_DICOMWEB_ENABLED=true

# ── Mock EHR / FHIR ────────────────────────────────────────
MOCK_FHIR_DATA_PATH=./app/storage/mock-data/fhir
MOCK_FHIR_ENABLED=true

# ── Phase 1: Vendor Model Registry (mocked) ───────────────
MOCK_VENDOR_MODELS_PATH=./app/storage/mock-data/vendor-models.json
VENDOR_SCOPE_GATE_MODE=block

# ── Phase 2: AutoML / Shadow Mode / RLHF ──────────────────
AUTOML_UPLOAD_ROOT=./app/storage/uploads
AUTOML_MODEL_ROOT=./app/storage/models
SHADOW_MODE_LOG_PATH=./app/storage/mock-data/shadow-predictions.json
SHADOW_MODE_LOG_RETENTION_DAYS=30
RLHF_REVIEWER_ROLE=demo_reviewer
MODEL_PROMOTION_THRESHOLD_ACCURACY=0.80
MODEL_PROMOTION_MIN_SAMPLE_SIZE=20

# ── Gemini API (used for medical report generation) ───────
# Enter your Google Gemini API key here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=true
GEMINI_MAX_TOKENS=1024
PHI_DETECTION_MODE=block_and_alert
LOCAL_FALLBACK_ENABLED=false

# ── HuggingFace (BiomedBERT — optional) ───────────────────
HF_TOKEN=your_huggingface_token_here

# ── Audit Logging ──────────────────────────────────────────
AUDIT_LOG_STORAGE_PATH=./logs/audit
